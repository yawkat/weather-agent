{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'helpers:pinGitHubActionDigests'],
  // Same cooldown as the flake update.
  minimumReleaseAge: '5 days',
  // Only the workflows for now. flake.lock is updated by update-flake.yml. The other versions are in the
  // [tool.pyronaut] tables and nix/, which Renovate doesn't read, and a bump needs new hashes in nix/deps.<system>.sha256
  // (one per system) and nix/venv.nix.
  enabledManagers: ['github-actions'],
}
